# --- Required Credentials ---
OPENAI_BASE_URL=https://rgyc2zv.abc-tunnel.us/v1/
OPENAI_API_KEY=your_api_key_or_token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

ADMIN_USER_IDS=your_telegram_id
ALLOWED_TELEGRAM_USER_IDS=*

# --- System Prompt & Behavior ---
ASSISTANT_PROMPT="You are a helpful, intelligent Telegram AI assistant. Be concise, precise, and polite. Answer voice and video messages directly and accurately."

# --- Models ---
OPENAI_MODEL=ag/gemini-3.8-flash-low
FALLBACK_MODEL=ag/gemini-3.7-flash-low
MAX_TOKENS=2048
ENABLE_FUNCTIONS=false
STREAM=true

# --- Vision & Recognition (Images & Video Notes) ---
ENABLE_VISION=true
VISION_MODEL=ag/gemini-3.8-flash-low

# --- Image Generation via Pollinations.ai ---
ENABLE_IMAGE_GENERATION=true
IMAGE_MODEL=pollinations
POLLINATIONS_MODEL=flux
# Optional API key if you have a paid/supporter tier; leave commented out for free tier
# POLLINATIONS_API_KEY=your_key_here

# --- Voice & Video Messages ---
ENABLE_TRANSCRIPTION=true
VOICE_REPLY_WITH_TRANSCRIPT_ONLY=false

# --- Group Chats ---
# Responds automatically when @mentioned or replied to (voice, video, text, photos)
IGNORE_GROUP_TRANSCRIPTIONS=true
IGNORE_GROUP_VISION=true
GROUP_TRIGGER_KEYWORD=""
