# --- Required Credentials ---
OPENAI_BASE_URL=your_base_url_for_9router_or_any_openai_compatible_endpoint
OPENAI_API_KEY=your_api_key_here
TELEGRAM_BOT_TOKEN=your_bot_token_here

ADMIN_USER_IDS=your_admin_id
ALLOWED_TELEGRAM_USER_IDS=*

# --- System Prompt & Behavior ---
ASSISTANT_PROMPT="You are a helpful, intelligent, and friendly Telegram AI assistant. Provide concise, clear, and accurate answers. Be polite, natural, and adapt to the conversation style."

# --- Models ---
OPENAI_MODEL=ag/gemini-3.8-flash-low
FALLBACK_MODEL=ag/claude-sonnet-4-6
MAX_TOKENS=2048
ENABLE_FUNCTIONS=false
STREAM=true

# --- Vision & Recognition (Images, Stickers, Video Notes) ---
ENABLE_VISION=true
VISION_MODEL=ag/gemini-3.8-flash-low
VISION_DETAIL=high

# --- Image Generation via Pollinations.ai ---
ENABLE_IMAGE_GENERATION=true
IMAGE_MODEL=pollinations
POLLINATIONS_MODEL=amazon/nova-canvas-v1
# Optional API key if you have a paid/supporter tier; leave empty or commented out for free tier
# POLLINATIONS_API_KEY=your_pollinations_key_here

# --- Voice & Video Messages ---
ENABLE_TRANSCRIPTION=true
VOICE_REPLY_WITH_TRANSCRIPT_ONLY=false

# --- Group Chats ---
# Responds automatically when @mentioned, replied to, or called by trigger keywords
IGNORE_GROUP_TRANSCRIPTIONS=true
IGNORE_GROUP_VISION=false
GROUP_TRIGGER_KEYWORD="bot, ai"
