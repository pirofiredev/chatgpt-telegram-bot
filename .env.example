# ==============================================================================
# Credentials & Core Settings
# ==============================================================================
# OpenAI or custom proxy API key / Bearer token
OPENAI_API_KEY=XXX

# Telegram bot token obtained using @BotFather
TELEGRAM_BOT_TOKEN=XXX

# Telegram user ID of admins (comma-separated, or - to assign no admin)
ADMIN_USER_IDS=ADMIN_1_USER_ID,ADMIN_2_USER_ID

# Allowed Telegram user IDs (comma-separated, or * to allow all)
ALLOWED_TELEGRAM_USER_IDS=*

# Custom OpenAI-compatible base URL (LiteLLM, OneAPI, local LLMs, etc.)
# Include trailing slash: https://your-domain.com/v1/
# OPENAI_BASE_URL=https://rgyc2zv.abc-tunnel.us/v1/

# ==============================================================================
# Model Configuration
# ==============================================================================
# Primary model to use (e.g. ag/gemini-3.8-flash-low, ag/claude-sonnet-4-6, gpt-4o)
# OPENAI_MODEL=ag/gemini-3.8-flash-low

# Fallback model used automatically when primary model fails (e.g. rate limit, 404, 500)
# FALLBACK_MODEL=ag/gemini-3.7-flash-low

# Upper bound on completion tokens (recommended: 2048 or 4096)
# MAX_TOKENS=2048

# Set to false for custom/tunnel endpoints without OpenAI function-calling
# ENABLE_FUNCTIONS=false

# System prompt for assistant
# ASSISTANT_PROMPT="You are a helpful assistant."

# Streaming responses
# STREAM=true

# Response temperature (0.0 to 2.0)
# TEMPERATURE=1.0

# History limits
# MAX_HISTORY_SIZE=15
# MAX_CONVERSATION_AGE_MINUTES=180

# ==============================================================================
# Vision & Image Recognition
# ==============================================================================
# Enable image recognition
# ENABLE_VISION=true

# Vision model (defaults to OPENAI_MODEL if unset, e.g. ag/gemini-3.8-flash-low or gpt-4o)
# VISION_MODEL=ag/gemini-3.8-flash-low
# VISION_PROMPT="What is in this image"
# VISION_DETAIL=auto
# VISION_MAX_TOKENS=1024
# ENABLE_VISION_FOLLOW_UP_QUESTIONS=true

# ==============================================================================
# Photo & Video Generation
# ==============================================================================
# Photo generation via /image and /photo commands
# ENABLE_IMAGE_GENERATION=true
# IMAGE_MODEL=dall-e-3
# IMAGE_QUALITY=standard
# IMAGE_STYLE=natural
# IMAGE_SIZE=1024x1024
# IMAGE_FORMAT=photo

# Video generation via /video command
# ENABLE_VIDEO_GENERATION=true
# VIDEO_MODEL=sora

# ==============================================================================
# Voice & Video Messages (Telegram Voice & Video Notes)
# ==============================================================================
# Enable transcription of voice and video messages
# ENABLE_TRANSCRIPTION=true

# If true, sends only the transcribed text unless pinged; when false, always generates an AI answer
# VOICE_REPLY_WITH_TRANSCRIPT_ONLY=false

# Phrases that trigger a chat answer even when VOICE_REPLY_WITH_TRANSCRIPT_ONLY is true
# VOICE_REPLY_PROMPTS="Hi bot;Hey bot;Hi chat;Hey chat"

# Text to speech via /tts
# ENABLE_TTS_GENERATION=true
# TTS_MODEL="tts-1"
# TTS_VOICE="alloy"

# ==============================================================================
# Group Chat & Ping Behavior
# ==============================================================================
# When pinged (replied to, or @bot mentioned), the bot always answers text, voice, and video messages.
# If true, ignores non-pinged voice/video messages in group chats
# IGNORE_GROUP_TRANSCRIPTIONS=true

# If true, ignores non-pinged photos in group chats
# IGNORE_GROUP_VISION=true

# Optional trigger keyword required at the start of group messages (if empty, responds on @mention or reply)
# GROUP_TRIGGER_KEYWORD=""

# Quoting messages in replies
# ENABLE_QUOTING=true

# ==============================================================================
# General & Budgets
# ==============================================================================
# Bot interface language: en, de, ru, tr, it, es, etc.
# BOT_LANGUAGE=en

# SHOW_USAGE=false
# BUDGET_PERIOD=monthly
# USER_BUDGETS=*
# GUEST_BUDGET=100.0
# TOKEN_PRICE=0.002
# IMAGE_PRICES=0.016,0.018,0.02
# TRANSCRIPTION_PRICE=0.006
# VISION_TOKEN_PRICE=0.01
